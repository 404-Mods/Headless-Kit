# Tebex Headless API — the PUBLIC webstore token from the Tebex Creator Panel
# (Store Settings → API Keys). Not a secret key.
# The store runs without it, but the catalogue will be empty.
TEBEX_TOKEN=

# Public base URL. Used for canonical links, the sitemap, and the
# complete/cancel URLs handed to Tebex at checkout.
NEXT_PUBLIC_STORE_URL=http://localhost:3000

# Serve a built-in demo catalogue instead of calling Tebex. Lets you click around
# a working storefront before you have a token. Checkout is disabled while on.
# NEXT_PUBLIC_DEMO_MODE=true
